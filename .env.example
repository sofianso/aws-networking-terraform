# Environment Variables Configuration
# Copy this file to .env and fill in your values

# AWS Account IDs
export AWS_NETWORKING_ACCOUNT_ID="123456789012"
export AWS_NONPROD_ACCOUNT_ID="234567890123"
export AWS_PROD_ACCOUNT_ID="345678901234"

# GitHub Configuration
export GITHUB_ORG="your-github-org"
export GITHUB_REPO="aws-networking-terraform"

# Default AWS Region
export AWS_DEFAULT_REGION="ap-southeast-2"

# Terragrunt Configuration
export TERRAGRUNT_NON_INTERACTIVE=true
export TERRAGRUNT_PARALLELISM=10
